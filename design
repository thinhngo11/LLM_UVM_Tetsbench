// DUT: 4-bit Up/Down Counter with enable, load and asynchronous reset
module counter (
    input  logic        clk,
    input  logic        rst_n,
    input  logic        en,
    input  logic        up_dn,
    input  logic        load,
    input  logic [3:0]  data_in,
    output logic [3:0]  count
);
    always @(posedge clk or negedge rst_n) begin
    //always @(posedge clk) begin
        if (!rst_n)
            count <= 4'b0;
        else if (load)
            count <= data_in;
        else if (en) begin
            if (up_dn)
                count <= count + 1;
            else
                count <= count - 1;
        end
    end
endmodule
